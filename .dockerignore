# Explicit allowlist: credentials, footage, outputs and local environments never enter the build context.
*
!Dockerfile
!requirements.lock
!main.py
!api.py
!config.yaml
!app/
!app/*.py
!assets/
!assets/fonts/
!assets/fonts/*.ttf
!assets/fonts/LICENSE.txt
!assets/music/
!assets/music/*.mp3
!assets/overlays/
!assets/overlays/*.mp4
!tests/
!tests/*.py
